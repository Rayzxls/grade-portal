// Student Grade Portal - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Enums ============
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum GradeLetter {
  A
  B_PLUS
  B
  C_PLUS
  C
  D_PLUS
  D
  F
  W   // Withdraw
  I   // Incomplete
}

enum Semester {
  FIRST
  SECOND
  SUMMER
}

// ============ Core Models ============
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student?
  teacher      Teacher?
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ชั้นเรียน (ป.1/1, ม.4/2 ...) ต่อปีการศึกษา
model Classroom {
  id                 String   @id @default(cuid())
  gradeLevel         String   // เช่น "ป.1", "ม.4"
  section            Int      // ห้อง: 1, 2, 3 ...
  academicYear       Int      // ปีการศึกษา พ.ศ. เช่น 2568
  homeroomTeacherId  String?
  createdAt          DateTime @default(now())

  homeroomTeacher Teacher?     @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students        Student[]
  scoreSheets     ScoreSheet[]

  @@unique([gradeLevel, section, academicYear])
  @@index([academicYear])
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  studentCode String   @unique // รหัสนักเรียน
  classroomId String?
  enrollYear  Int      // ปีที่เข้าเรียน (พ.ศ.)
  createdAt   DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom   Classroom?     @relation(fields: [classroomId], references: [id])
  enrollments Enrollment[]
  grades      Grade[]
  scores      StudentScore[]

  @@index([studentCode])
  @@index([classroomId])
}

model Teacher {
  id         String  @id @default(cuid())
  userId     String  @unique
  staffCode  String  @unique
  department String

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     Course[]
  homerooms   Classroom[]  @relation("HomeroomTeacher")
  scoreSheets ScoreSheet[]
}

model Course {
  id         String   @id @default(cuid())
  code       String   @unique // เช่น MATH-M4-001
  name       String
  credits    Int
  gradeLevel String   // ชั้นที่เรียนวิชานี้ เช่น "ม.4"
  teacherId  String
  createdAt  DateTime @default(now())

  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  scoreSheets ScoreSheet[]

  @@index([code])
  @@index([gradeLevel])
}

model AcademicTerm {
  id        String   @id @default(cuid())
  year      Int      // ปีการศึกษา เช่น 2568
  semester  Semester
  startDate DateTime
  endDate   DateTime

  enrollments Enrollment[]
  scoreSheets ScoreSheet[]

  @@unique([year, semester])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  termId    String
  createdAt DateTime @default(now())

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])
  grade   Grade?

  @@unique([studentId, courseId, termId])
  @@index([studentId])
}

model Grade {
  id           String      @id @default(cuid())
  enrollmentId String      @unique
  studentId    String      // denormalized เพื่อ query เร็ว
  score        Float       // 0-100
  letter       GradeLetter
  gradePoint   Float       // 4.0, 3.5, 3.0 ...
  recordedById String      // teacher user id
  recordedAt   DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

// สมุดเก็บคะแนน — 1 เล่ม = 1 วิชา × 1 ห้อง × 1 เทอม
model ScoreSheet {
  id             String   @id @default(cuid())
  classroomId    String
  courseId       String
  termId         String
  ownerTeacherId String
  finalizedAt    DateTime?  // เมื่อปิดเล่ม → กลายเป็น readonly + Grade ถูกสร้าง
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classroom Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id])
  term      AcademicTerm   @relation(fields: [termId], references: [id])
  owner     Teacher        @relation(fields: [ownerTeacherId], references: [id])
  columns   ScoreColumn[]
  entries   StudentScore[]

  @@unique([classroomId, courseId, termId])
  @@index([ownerTeacherId])
}

model ScoreColumn {
  id           String  @id @default(cuid())
  scoreSheetId String
  name         String  // เช่น "สอบกลางภาค"
  maxScore     Float   // เช่น 30
  order        Int

  scoreSheet ScoreSheet     @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  scores     StudentScore[]

  @@unique([scoreSheetId, order])
  @@index([scoreSheetId])
}

model StudentScore {
  id           String  @id @default(cuid())
  scoreSheetId String
  columnId     String
  studentId    String
  value        Float?  // null = ยังไม่บันทึก
  updatedAt    DateTime @updatedAt

  scoreSheet ScoreSheet  @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  column     ScoreColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([columnId, studentId])
  @@index([scoreSheetId])
  @@index([studentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // GRADE_CREATE, GRADE_UPDATE, GRADE_DELETE
  entityType String   // Grade, User, ...
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
